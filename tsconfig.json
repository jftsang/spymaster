{
    "compilerOptions": {
        "target": "es2016",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2016", "dom", "dom.iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    },
    "include": [
        "src/frontend/static/**/*"
    ]
}
