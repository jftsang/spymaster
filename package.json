{
  "name": "spymaster",
  "version": "1.0.0",
  "description": "Spymaster game frontend",
  "source": [
    "src/frontend/main.html",
    "src/frontend/content.html",
    "src/frontend/weights.html",
    "src/frontend/tournaments.html"
  ],
  "scripts": {
    "build": "parcel build --dist-dir dist/frontend",
    "watch": "parcel watch --dist-dir dist/frontend",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.13.2",
    "parcel": "^2.16.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  }
}
